function ProbeBakeDlg::onWake(%this)
{
   //set up
   ProbeBakeDlg_ProbeResList.add( "32" );  
   ProbeBakeDlg_ProbeResList.add( "64" );
   ProbeBakeDlg_ProbeResList.add( "128" );
   ProbeBakeDlg_ProbeResList.add( "256" );
   ProbeBakeDlg_ProbeResList.add( "512" );
   ProbeBakeDlg_ProbeResList.add( "1024" );
   ProbeBakeDlg_ProbeResList.add( "2048" );
   
   ProbeBakeDlg_ProbeResList.setSelected( 1, false );
   
   ProbeBakeDlg_NumIterTxt.setText("1");
}

function ProbeBakeDlg_RunBake::onClick(%this)
{
   //While a bake is running the button is the cancel button
   if (ProbeBin.isBaking())
   {
      ProbeBin.cancelBake();
      return;
   }

   %numIter = ProbeBakeDlg_NumIterTxt.getText();
   if (%numIter < 1)
      %numIter = 1;

   $ProbeBakeDlg::NumIter = %numIter;
   $ProbeBakeDlg::Iter = 0;

   $pref::ReflectionProbes::BakeResolution = ProbeBakeDlg_ProbeResList.getText();
   $pref::ReflectionProbes::captureLightFloor = ProbeBakeDlg_LightFloorTxt.getText();

   ProbeBakeDlg_Progress.setValue(0);
   ProbeBakeDlg_RunBake.setText("Cancel");
   Canvas.repaint();

   ProbeBakeDlg.startIteration();
}

//The bake can't finish inside one call, as it has to wait for the network to deliver the ghosts of the SubScenes' probes.
//So an iteration is started here and the next one is started from the completion callback
function ProbeBakeDlg::startIteration(%this)
{
   $pref::ReflectionProbes::RenderWithProbes = ($ProbeBakeDlg::Iter != 0);
   $pref::ReflectionProbes::CurrentLevelPath = filePath($Server::MissionFile) @ "/" @ fileBase($Server::MissionFile) @ "/probes/";

   if (!ProbeBin.startBakeProbes())
      ProbeBakeDlg.finishBake(false);
}

function ProbeBakeDlg::finishBake(%this, %success)
{
   ProbeBakeDlg_RunBake.setText("Update Probes");

   if (%success)
   {
      ProbeBakeDlg_Progress.setValue(1);
      EWorldEditor.isDirty = true;
   }
}

function ProbeBin::onProbeBakeProgress(%this, %done, %total)
{
   if (!ProbeBakeDlg.isAwake())
      return;

   %fraction = 0;
   if (%total > 0)
      %fraction = %done / %total;

   ProbeBakeDlg_Progress.setValue((($ProbeBakeDlg::Iter + %fraction) / $ProbeBakeDlg::NumIter));

   //The bake loop runs inside one call, so the editor only redraws here
   Canvas.repaint();
}

function ProbeBin::onProbeBakeComplete(%this, %success)
{
   $ProbeBakeDlg::Iter++;

   if (%success && $ProbeBakeDlg::Iter < $ProbeBakeDlg::NumIter)
      ProbeBakeDlg.startIteration();
   else
      ProbeBakeDlg.finishBake(%success);
}